<resources>
    <!--
      Desktop-only strings, merged into the copy of the Android app's strings.xml
      by the syncAppStrings task (which appends these lines before its closing
      tag). app/ stays upstream-untouched; the words only this build needs live
      here. The Chinese half is values-zh/strings.xml beside this file.
    -->

    <!-- Sidebar -->
    <string name="browse">Browse</string>
    <string name="sidebar_youtube_music">YouTube Music</string>
    <string name="recently_added">Recently Added</string>

    <!-- Toolbar -->
    <string name="forward">Forward</string>
    <string name="volume">Volume</string>

    <!-- Playback status, structured as PlaybackStatus and worded here -->
    <string name="status_resolving">Resolving…</string>
    <string name="status_opening">Opening %1$s…</string>
    <string name="status_nothing_playable">Nothing playable in %1$s</string>
    <string name="status_resolve_failed">Couldn’t load this track</string>
    <string name="status_engine_error">Playback error: %1$s</string>

    <!-- Row menu -->
    <string name="copy_link">Copy link</string>

    <!-- Settings dialog -->
    <string name="light_theme">Light</string>
    <string name="dark_theme">Dark</string>
    <string name="translucent_window">Translucent window (Mica)</string>
    <string name="translucent_window_subtitle">Let the desktop’s Mica material show through the toolbar and sidebar. Off draws an opaque window, which resizes more smoothly.</string>
    <string name="restart_to_apply">Takes effect the next time BitChord starts</string>
    <string name="about">About</string>
    <string name="about_upstream">A desktop build of BitChord, upstream kushagrasinghx/BitChord. Music from YouTube Music.</string>
    <string name="autoplay_subtitle">Keep the music going: as the queue’s last track starts, similar music fills the slots behind it.</string>
    <string name="lyrics">Lyrics</string>
    <string name="downloads_empty">Nothing downloaded yet. Right-click any track and choose Download.</string>

    <!-- Quality badge: the direction-neutral word for a swap in flight (upstream says
         "Upgrading quality", but this swap can run downhill too — the setting fell). -->
    <string name="switching_quality">Switching quality…</string>

    <!-- Output device: the always-present way back to letting the OS choose
         (the platform itself falls back to this when a chosen endpoint dies). -->
    <string name="system_default">System default</string>

    <!-- Account: the settings group header and account removal. (The identity
         picker's "Listen as" row is upstream's own `listen_as` key — grep the
         merged strings before adding here.) -->
    <string name="account">Account</string>
    <string name="remove_account">Remove this account</string>

    <!-- Local music: the only genuinely desktop-specific words of slice 11.
         Everything else the page and the WebDAV group say comes from the
         upstream `local_music*` / `webdav*` / `sort_*` families, which the
         string merge copies in wholesale. -->
    <string name="local_music_add_folder">Add folder…</string>
    <string name="local_music_remove_folder">Remove this folder</string>
    <string name="local_music_no_folders">No folders to scan yet. Choose your music folders in Settings → Local Music.</string>
    <string name="local_music_delete_confirm">Delete %1$d selected file(s) from disk?</string>
    <string name="liquid_glass_subtitle_desktop">Real refracting glass on the player's controls. Uses more GPU.</string>
    <string name="reduce_dynamic_blur_subtitle_desktop">Swaps frosted glass for solid fills across the app.</string>

    <!-- Playback dials (slice 18): the speed row is the desktop's own wording —
         upstream carries the setting with no surface for it — and the skip-silence
         subtitle says what this build's decoder actually does, where upstream's
         own subtitle already admits it does nothing on float output. -->
    <string name="playback_speed">Playback speed</string>
    <string name="playback_speed_subtitle">How fast the music plays, from half to double.</string>
    <string name="skip_silence_subtitle_desktop">Trims long silences — not yet on this build's decoder; recorded for when it can.</string>

    <!-- Backup & update (slice 19): the subtitles say what this build actually
         keeps — no listening stats yet, so "listening history" would promise a
         page the desktop does not have. -->
    <string name="export_data_subtitle_desktop">Settings and search history, as one JSON file</string>
    <string name="check_for_updates">Check for updates</string>
    <string name="update_none">BitChord is up to date</string>
    <string name="update_open_release">Open release page</string>
</resources>
